<% layout("/layouts/boilerplate") %>

<div class="auth-wrap">
  <div class="auth-card">
    <h1>Create your account</h1>
    <p class="auth-sub">Join Homestay to book stays or host your own place.</p>

    <form action="/signup" method="post" class="needs-validation" novalidate>
      <input type="hidden" name="returnTo" value="<%= typeof returnTo !== 'undefined' ? returnTo : '' %>">
      <div class="mb-3">
        <label for="username" class="form-label">Username</label>
        <div class="input-icon">
          <i class="fa-regular fa-user"></i>
          <input type="text" id="username" name="username" placeholder="choose a username" class="form-control" autocomplete="username" required>
        </div>
      </div>

      <div class="mb-3">
        <label for="email" class="form-label">Email</label>
        <div class="input-icon">
          <i class="fa-regular fa-envelope"></i>
          <input type="email" id="email" name="email" placeholder="you@example.com" class="form-control" autocomplete="email" required>
        </div>
      </div>

      <div class="mb-3">
        <label for="password" class="form-label">Password</label>
        <div class="input-icon">
          <i class="fa-solid fa-lock"></i>
          <input type="password" id="password" name="password" placeholder="at least 8 characters" class="form-control" autocomplete="new-password" required>
        </div>
      </div>

      <button class="btn btn-brand w-100 mt-2">Sign up</button>
    </form>

    <p class="auth-alt">Already have an account? <a href="/login<%= typeof returnTo !== 'undefined' && returnTo ? '?returnTo=' + encodeURIComponent(returnTo) : '' %>">Log in</a></p>
  </div>
</div>
