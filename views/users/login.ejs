<% layout("/layouts/boilerplate") %>

<div class="auth-wrap">
  <div class="auth-card">
    <h1>Welcome back</h1>
    <p class="auth-sub">Log in to manage your listings and reviews.</p>

    <form action="/login" method="post" class="needs-validation" novalidate>
      <div class="mb-3">
        <label for="username" class="form-label">Username</label>
        <div class="input-icon">
          <i class="fa-regular fa-user"></i>
          <input type="text" id="username" name="username" placeholder="your username" class="form-control" autocomplete="username" required>
        </div>
      </div>

      <div class="mb-3">
        <label for="password" class="form-label">Password</label>
        <div class="input-icon">
          <i class="fa-solid fa-lock"></i>
          <input type="password" id="password" name="password" placeholder="your password" class="form-control" autocomplete="current-password" required>
        </div>
      </div>

      <button class="btn btn-brand w-100 mt-2">Log in</button>
    </form>

    <p class="auth-alt">New to Homestay? <a href="/signup">Create an account</a></p>
  </div>
</div>
