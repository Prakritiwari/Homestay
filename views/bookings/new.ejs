<% layout("/layouts/boilerplate") %>

<%
  const imageUrl = listing.image && listing.image.url ? listing.image.url : null;
  const methodLabels = { card: "Card", upi: "UPI", netbanking: "Net banking" };
%>

<section class="checkout-header">
  <a href="/listings/<%= listing._id %>" class="checkout-back"><i class="fa-solid fa-arrow-left"></i> Back to listing</a>
  <h1>Confirm and pay</h1>
  <p>Review your stay and complete the payment to reserve it.</p>
</section>

<div class="row g-4">
  <div class="col-lg-7">
    <form action="/listings/<%= listing._id %>/bookings" method="POST" class="checkout-card" id="paymentForm">
      <input type="hidden" name="booking[checkIn]" value="<%= checkIn %>">
      <input type="hidden" name="booking[checkOut]" value="<%= checkOut %>">
      <input type="hidden" name="booking[guests]" value="<%= guests %>">

      <h2 class="section-title">Your trip</h2>
      <div class="checkout-trip">
        <div><span>Check-in</span><strong><%= checkInDisplay %></strong></div>
        <div><span>Check-out</span><strong><%= checkOutDisplay %></strong></div>
        <div><span>Guests</span><strong><%= guests %> guest<%= guests === 1 ? "" : "s" %></strong></div>
        <div><span>Nights</span><strong><%= nights %></strong></div>
      </div>
      <a href="/listings/<%= listing._id %>" class="checkout-change">Change dates</a>

      <hr>

      <h2 class="section-title">Payment method</h2>
      <div class="payment-methods">
        <label class="payment-method">
          <input type="radio" name="booking[paymentMethod]" value="card" checked>
          <span><i class="fa-regular fa-credit-card"></i> Card</span>
        </label>
        <label class="payment-method">
          <input type="radio" name="booking[paymentMethod]" value="upi">
          <span><i class="fa-solid fa-mobile-screen-button"></i> UPI</span>
        </label>
        <label class="payment-method">
          <input type="radio" name="booking[paymentMethod]" value="netbanking">
          <span><i class="fa-solid fa-building-columns"></i> Net banking</span>
        </label>
      </div>

      <div data-payment-fields="card">
        <div class="mb-3">
          <label class="form-label" for="cardName">Cardholder name</label>
          <input type="text" id="cardName" name="booking[cardName]" class="form-control" placeholder="Name on card" autocomplete="cc-name" data-required="true">
        </div>

        <div class="mb-3">
          <label class="form-label" for="cardNumber">Card number</label>
          <input type="text" id="cardNumber" name="booking[cardNumber]" class="form-control" placeholder="4242 4242 4242 4242" inputmode="numeric" autocomplete="cc-number" data-required="true">
        </div>

        <div class="row">
          <div class="col-6">
            <label class="form-label" for="cardExpiry">Expiry</label>
            <input type="text" id="cardExpiry" name="booking[cardExpiry]" class="form-control" placeholder="MM/YY" inputmode="numeric" autocomplete="cc-exp" data-required="true">
          </div>
          <div class="col-6">
            <label class="form-label" for="cardCvv">CVV</label>
            <input type="password" id="cardCvv" name="booking[cardCvv]" class="form-control" placeholder="123" inputmode="numeric" maxlength="4" autocomplete="cc-csc" data-required="true">
          </div>
        </div>
      </div>

      <div data-payment-fields="upi" class="d-none">
        <label class="form-label" for="upiId">UPI ID</label>
        <input type="text" id="upiId" name="booking[upiId]" class="form-control" placeholder="yourname@bank" data-required="true">
        <p class="form-hint">You'll receive a collect request from Homestay (simulated).</p>
      </div>

      <div data-payment-fields="netbanking" class="d-none">
        <label class="form-label" for="bankName">Choose your bank</label>
        <select id="bankName" name="booking[bankName]" class="form-select" data-required="true">
          <option value="">Select a bank</option>
          <option value="HDFC Bank">HDFC Bank</option>
          <option value="ICICI Bank">ICICI Bank</option>
          <option value="State Bank of India">State Bank of India</option>
          <option value="Axis Bank">Axis Bank</option>
          <option value="Kotak Mahindra Bank">Kotak Mahindra Bank</option>
          <option value="Other">Other</option>
        </select>
      </div>

      <div class="demo-payment-note">
        <i class="fa-solid fa-circle-info"></i>
        <span><strong>Demo payment module.</strong> No real money is charged. Use card <strong>4242 4242 4242 4242</strong> with any future expiry to succeed, or a card ending in <strong>0000</strong> to simulate a decline.</span>
      </div>

      <button class="btn btn-brand w-100 mt-3" type="submit">
        Pay &#8377;<%= pricing.total.toLocaleString("en-IN") %> &amp; reserve
      </button>
      <div class="booking-note"><i class="fa-solid fa-lock me-1"></i>Your card details are never stored.</div>
    </form>
  </div>

  <div class="col-lg-5">
    <aside class="checkout-summary">
      <div class="checkout-listing">
        <% if(imageUrl){ %>
          <img src="<%= imageUrl %>" alt="<%= listing.title %>">
        <% } else { %>
          <span class="checkout-listing-placeholder"><i class="fa-regular fa-image"></i></span>
        <% } %>
        <div>
          <h2><%= listing.title %></h2>
          <p class="card-meta"><%= listing.location %><% if(listing.country){ %>, <%= listing.country %><% } %></p>
          <% if(listing.category){ %><span class="badge-category mt-2 d-inline-block"><%= listing.category %></span><% } %>
        </div>
      </div>

      <hr>

      <h2 class="section-title">Price details</h2>
      <div class="price-row">
        <span>&#8377;<%= pricePerNight.toLocaleString("en-IN") %> &times; <%= nights %> night<%= nights === 1 ? "" : "s" %></span>
        <span>&#8377;<%= pricing.subtotal.toLocaleString("en-IN") %></span>
      </div>
      <div class="price-row">
        <span>GST (18%)</span>
        <span>&#8377;<%= pricing.tax.toLocaleString("en-IN") %></span>
      </div>
      <div class="price-row total">
        <span>Total (INR)</span>
        <span>&#8377;<%= pricing.total.toLocaleString("en-IN") %></span>
      </div>

      <div class="booking-note"><i class="fa-solid fa-shield-halved me-1"></i>Secured demo checkout</div>
    </aside>
  </div>
</div>

<script src="/js/booking.js"></script>
