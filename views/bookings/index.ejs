<% layout("/layouts/boilerplate") %>

<%
  const formatDate = (value) => new Date(value).toLocaleDateString("en-IN", {
    day: "numeric",
    month: "short",
    year: "numeric",
    timeZone: "UTC",
  });
%>

<header class="trips-header">
  <div>
    <h1>My trips</h1>
    <p><%= bookings.length %> booking<%= bookings.length === 1 ? "" : "s" %> on your account.</p>
  </div>
  <a href="/listings" class="btn btn-brand"><i class="fa-solid fa-compass me-1"></i>Explore stays</a>
</header>

<% if(bookings.length > 0){ %>
  <div class="trip-list">
    <% for(const booking of bookings){ %>
      <%
        const listing = booking.listing;
        const imageUrl = listing && listing.image && listing.image.url ? listing.image.url : null;
      %>
      <article class="trip-card">
        <% if(listing){ %>
          <a href="/listings/<%= listing._id %>" class="trip-img-wrap">
            <% if(imageUrl){ %>
              <img src="<%= imageUrl %>" alt="<%= listing.title %>" loading="lazy">
            <% } else { %>
              <span class="card-img-placeholder"><i class="fa-regular fa-image"></i></span>
            <% } %>
          </a>
        <% } else { %>
          <span class="trip-img-wrap"><span class="card-img-placeholder"><i class="fa-regular fa-image"></i></span></span>
        <% } %>

        <div class="trip-body">
          <div class="trip-top">
            <div>
              <h2><%= listing ? listing.title : "Listing removed" %></h2>
              <% if(listing){ %>
                <p class="card-meta"><%= listing.location %><% if(listing.country){ %>, <%= listing.country %><% } %></p>
              <% } %>
            </div>
            <span class="status-badge status-<%= booking.status %>"><%= booking.status %></span>
          </div>

          <div class="trip-meta">
            <span><i class="fa-regular fa-calendar me-1"></i><%= formatDate(booking.checkIn) %> &rarr; <%= formatDate(booking.checkOut) %></span>
            <span><i class="fa-solid fa-user-group me-1"></i><%= booking.guests %> guest<%= booking.guests === 1 ? "" : "s" %></span>
            <span><i class="fa-solid fa-moon me-1"></i><%= booking.nights %> night<%= booking.nights === 1 ? "" : "s" %></span>
          </div>

          <div class="trip-footer">
            <strong>&#8377;<%= booking.total.toLocaleString("en-IN") %> <span class="card-meta fw-normal">total</span></strong>
            <a href="/bookings/<%= booking._id %>" class="btn btn-ghost btn-sm">View booking</a>
          </div>
        </div>
      </article>
    <% } %>
  </div>
<% } else { %>
  <div class="empty-state">
    <i class="fa-regular fa-calendar-xmark"></i>
    <h4>No trips yet</h4>
    <p>When you reserve a stay it will show up here, along with your payment and booking details.</p>
    <a href="/listings" class="btn btn-brand">Find your first stay</a>
  </div>
<% } %>
